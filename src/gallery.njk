---
layout: base.njk
current: gallery
title: Gallery · Lumen Project
description: Photographs from Lumen Project happenings of sound, light and space in churches and large rooms.
permalink: /gallery/
ogImage: assets/img/share/lumenproject-share-gallery.jpg
ogImageW: 1200
ogImageH: 630
ogImageAlt: A photograph from a Lumen Project happening
---
<div class="wrap page gallery-head">
  <h1 class="visually-hidden">Gallery</h1>
  <p class="page-intro">{{ lumen.settings.gallery_intro }}{% if lumen.photographers.length %}<br />Photography by {% for p in lumen.photographers %}{% if not loop.first %}{% if loop.last %} and {% else %}, {% endif %}{% endif %}{% if p.URL %}<a href="{{ p.URL }}" target="_blank" rel="noopener">{{ p.Name }}</a>{% else %}{{ p.Name }}{% endif %}{% endfor %}.{% endif %}</p>
</div>

<div class="gallery">
  {% for img in gallery %}
  <figure class="gallery__item">
    <a href="{{ img.src }}" aria-label="View full photograph {{ loop.index }} of {{ gallery.length }}">
      {% galleryImg img.src, "", "(max-width: 640px) 92vw, (max-width: 1100px) 45vw, 320px" %}
    </a>
  </figure>
  {% endfor %}
</div>
