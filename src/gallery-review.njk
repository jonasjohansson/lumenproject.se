---
permalink: /gallery-review/
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Gallery review · Lumen Project</title>
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #111;
      color: #eee;
      font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    header {
      position: sticky; top: 0; z-index: 10;
      background: rgba(17,17,17,.92);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid #2a2a2a;
      padding: 14px 18px;
      display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    }
    header h1 { font-size: 16px; margin: 0; font-weight: 600; }
    .count { font-variant-numeric: tabular-nums; opacity: .8; }
    .spacer { flex: 1 1 auto; }
    button {
      font: inherit; cursor: pointer;
      background: #1d1d1d; color: #eee;
      border: 1px solid #3a3a3a; border-radius: 8px;
      padding: 8px 14px;
    }
    button:hover { background: #262626; }
    button.primary { background: #2d6cdf; border-color: #2d6cdf; color: #fff; }
    button.primary:hover { background: #3a78e6; }
    .hint { padding: 12px 18px; opacity: .65; font-size: 14px; }
    .grid {
      columns: 320px;
      column-gap: 12px;
      padding: 0 12px 60px;
    }
    figure {
      margin: 0 0 12px;
      break-inside: avoid;
      position: relative;
      cursor: pointer;
      border-radius: 8px;
      overflow: hidden;
      outline: 3px solid transparent;
      transition: outline-color .12s ease;
    }
    figure img { display: block; width: 100%; height: auto; transition: opacity .12s ease, filter .12s ease; }
    /* discarded state */
    figure[aria-pressed="false"] img { opacity: .28; filter: grayscale(1); }
    figure[aria-pressed="true"] { outline-color: #3fbf6a; }
    .badge {
      position: absolute; top: 8px; right: 8px;
      width: 28px; height: 28px; border-radius: 50%;
      display: grid; place-items: center;
      font-size: 16px; font-weight: 700;
      background: rgba(0,0,0,.55); color: #fff;
      pointer-events: none;
    }
    figure[aria-pressed="true"] .badge { background: #3fbf6a; }
    figure[aria-pressed="false"] .badge::after { content: "✕"; }
    figure[aria-pressed="true"]  .badge::after { content: "✓"; }
    .name {
      position: absolute; left: 0; right: 0; bottom: 0;
      padding: 6px 8px;
      font-size: 11px; font-variant-numeric: tabular-nums;
      background: linear-gradient(transparent, rgba(0,0,0,.75));
      pointer-events: none; word-break: break-all;
    }
  </style>
</head>
<body>
  <header>
    <h1>Gallery review</h1>
    <span class="count"><b id="kept">0</b> kept / <span id="total">0</span></span>
    <span class="spacer"></span>
    <button id="keepAll">Keep all</button>
    <button id="clearAll">Clear all</button>
    <button id="download" class="primary">Download JSON</button>
  </header>

  <p class="hint">
    Click a photo to toggle it. Green check = <b>keep</b>, dimmed ✕ = <b>remove</b>.
    Your choices are saved automatically in this browser. When done, click
    <b>Download JSON</b> and send the file back.
  </p>

  <div class="grid" id="grid">
    {% for img in gallery %}
    <figure data-src="{{ img.src }}">
      <img src="{{ img.src }}" {% if img.width %}width="{{ img.width }}" height="{{ img.height }}" {% endif %}alt="" loading="lazy" decoding="async" />
      <span class="badge"></span>
      <span class="name"></span>
    </figure>
    {% endfor %}
  </div>

  <script>
    (function () {
      var STORAGE_KEY = "lumen-gallery-review-v1";
      var figs = Array.prototype.slice.call(document.querySelectorAll("figure"));
      var keptEl = document.getElementById("kept");
      var totalEl = document.getElementById("total");
      totalEl.textContent = figs.length;

      function fileOf(src) { return src.split("/").pop(); }

      // Load saved state: a map of filename -> boolean keep. Default keep = true.
      var saved;
      try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch (e) { saved = {}; }

      function save() {
        var map = {};
        figs.forEach(function (f) {
          map[fileOf(f.dataset.src)] = f.getAttribute("aria-pressed") === "true";
        });
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(map)); } catch (e) {}
      }

      function updateCount() {
        var n = figs.filter(function (f) { return f.getAttribute("aria-pressed") === "true"; }).length;
        keptEl.textContent = n;
      }

      function setState(f, keep) { f.setAttribute("aria-pressed", keep ? "true" : "false"); }

      figs.forEach(function (f) {
        var file = fileOf(f.dataset.src);
        f.querySelector(".name").textContent = file;
        var keep = saved.hasOwnProperty(file) ? !!saved[file] : true; // default: keep
        setState(f, keep);
        f.addEventListener("click", function () {
          setState(f, f.getAttribute("aria-pressed") !== "true");
          updateCount(); save();
        });
      });
      updateCount();

      document.getElementById("keepAll").addEventListener("click", function () {
        figs.forEach(function (f) { setState(f, true); }); updateCount(); save();
      });
      document.getElementById("clearAll").addEventListener("click", function () {
        figs.forEach(function (f) { setState(f, false); }); updateCount(); save();
      });

      document.getElementById("download").addEventListener("click", function () {
        var keep = [], remove = [];
        figs.forEach(function (f) {
          var file = fileOf(f.dataset.src);
          (f.getAttribute("aria-pressed") === "true" ? keep : remove).push(file);
        });
        var data = { keep: keep, remove: remove, total: figs.length };
        var blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
        var a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "gallery-keep.json";
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
      });
    })();
  </script>
</body>
</html>
