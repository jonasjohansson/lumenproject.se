---
layout: base.njk
current: home
title: Lumen Project
description: A non-profit redefining the concert as a communal happening through sound, light and space. Lie down, sleep, come and go. Stockholm.
permalink: /
---
<section class="hero">
  {# only the active phase's image loads first (LCP); the other two load after
     window load so they're ready to crossfade on a theme toggle #}
  <img class="hero__img hero__img--day" data-srcset="/assets/img/photos/hero-day-sm.jpg 1100w, /assets/img/photos/hero-day.jpg 2200w" data-src="/assets/img/photos/hero-day.jpg" sizes="100vw" alt="" aria-hidden="true" decoding="async" />
  <img class="hero__img hero__img--dusk" data-srcset="/assets/img/photos/hero-dusk-sm.jpg 1100w, /assets/img/photos/hero-dusk.jpg 2200w" data-src="/assets/img/photos/hero-dusk.jpg" sizes="100vw" alt="A Lumen Project performance in a sunlit hall, photographed by Olga Androsova" decoding="async" />
  <img class="hero__img hero__img--night" data-srcset="/assets/img/photos/hero-night-sm.jpg 1100w, /assets/img/photos/hero-night.jpg 2200w" data-src="/assets/img/photos/hero-night.jpg" sizes="100vw" alt="" aria-hidden="true" decoding="async" />
  <script>
    (function () {
      var t = document.documentElement.dataset.theme || "night";
      var imgs = [].slice.call(document.querySelectorAll(".hero__img"));
      function load(i) { if (!i || i.src) return; if (i.dataset.srcset) i.srcset = i.dataset.srcset; i.src = i.dataset.src; }
      var active = document.querySelector(".hero__img--" + t) || imgs[0];
      if (active) active.setAttribute("fetchpriority", "high");
      load(active);
      addEventListener("load", function () { imgs.forEach(load); });
    })();
  </script>
  <div class="hero__inner">
    <h1 class="wordmark">Lumen<span class="l2">Project</span></h1>
    <p class="hero__tag">{{ lumen.settings.tagline }}</p>

    <div class="hero__scrolls">
      <a class="hero__cta" href="#events">See events</a>
      {% if lumen.nextEvent %}<span class="nextev"><span class="k">Next</span> <a href="{{ lumen.nextEvent.url }}">{{ lumen.nextEvent.Title }}</a>, {{ lumen.nextEvent.Date | eventDate }}</span>{% endif %}
    </div>
  </div>
</section>

<section class="section section--center">
  <div class="wrap">
    <p class="manifest">The concert as a spiritual, communal happening. <span class="dim">Day into dusk into night.</span></p>
  </div>
</section>

<section class="home-sec" id="events" aria-label="Events">
  <div class="wrap">
    {% include "partials/events-sections.njk" %}
  </div>
</section>

<section class="home-sec" id="artists" aria-label="Artists">
  <div class="wrap">
    <p class="page-intro">{{ lumen.artists.length }} musicians, composers and performers have shaped <strong>Lumen Project</strong> since 2017.</p>
    {% include "partials/artists-list.njk" %}
  </div>
</section>

<section class="home-sec" id="gallery" aria-label="Gallery">
  <div class="wrap">
    <a class="teaser-head" href="/gallery/">Gallery <span class="arrow">&rarr;</span></a>
    <a class="teaser" href="/gallery/" aria-label="Open the photo gallery">
      {% for img in gallery %}{% if loop.index <= 6 %}<img src="{{ img.src }}" {% if img.width %}width="{{ img.width }}" height="{{ img.height }}" {% endif %}alt="" loading="lazy" decoding="async" />{% endif %}{% endfor %}
    </a>
  </div>
</section>

<section class="home-sec" id="about" aria-label="About">
  <div class="wrap">
    {% include "partials/about-lead.njk" %}
    {% include "partials/about-cols.njk" %}
  </div>
</section>
