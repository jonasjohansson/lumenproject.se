---
layout: base.njk
current: home
title: Lumen Project
permalink: /
eleventyComputed:
  description: "{{ lumen.settings.home_description }}"
---
<section class="hero">
  {# only the active phase's image loads first (LCP); the other loads after
     window load so it's ready to crossfade on a theme toggle #}
  <img class="hero__img hero__img--day" data-srcset="/assets/img/photos/olga-androsova-lumenproject-hero-day-sm.jpg 1100w, /assets/img/photos/olga-androsova-lumenproject-hero-day.jpg 2200w" data-src="/assets/img/photos/olga-androsova-lumenproject-hero-day.jpg" sizes="100vw" alt="A Lumen Project performance, photographed by Olga Androsova" decoding="async" />
  <img class="hero__img hero__img--night" data-srcset="/assets/img/photos/olga-androsova-lumenproject-hero-night-sm.jpg 1100w, /assets/img/photos/olga-androsova-lumenproject-hero-night.jpg 2200w" data-src="/assets/img/photos/olga-androsova-lumenproject-hero-night.jpg" sizes="100vw" alt="" aria-hidden="true" decoding="async" />
  <script>
    (function () {
      var t = document.documentElement.dataset.theme || "night";
      var imgs = [].slice.call(document.querySelectorAll(".hero__img"));
      function load(i) { if (!i || i.src) return; if (i.dataset.srcset) i.srcset = i.dataset.srcset; i.src = i.dataset.src; }
      var active = document.querySelector(".hero__img--" + t) || imgs[0];
      if (active) active.setAttribute("fetchpriority", "high");
      load(active);
      addEventListener("load", function () { imgs.forEach(load); });
    })();
  </script>
  <div class="hero__inner">
    <h1 class="wordmark">Lumen<span class="l2">Project</span></h1>
    <p class="hero__tag">{{ lumen.settings.tagline }}</p>

    {% if lumen.nextEvent %}
    <div class="hero__scrolls">
      <span class="nextev"><span class="k">Upcoming</span> <a href="{{ lumen.nextEvent.url }}">{{ lumen.nextEvent.Title }}</a></span>
    </div>
    {% endif %}
  </div>
</section>
