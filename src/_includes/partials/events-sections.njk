{# Reusable events listing: upcoming featured + year-grouped archive.
   Used by the one-page home (#events) and the standalone /events/ page. #}
{% if lumen.upcoming.length %}
<div aria-label="Upcoming">
  {% for e in lumen.upcoming %}
  <a class="featured" href="{{ e.url }}">
    <div class="featured__media">
      <span class="featured__badge">Upcoming</span>
      {% if e.ImageURL %}<img src="{{ e.ImageURL | img }}" alt="{{ e.Title }} — poster"{% if e.dims %} width="{{ e.dims.width }}" height="{{ e.dims.height }}"{% endif %} decoding="async" />{% endif %}
    </div>
    <div class="featured__body">
      <p class="featured__date">{{ e.Date | eventDate }}</p>
      <h3 class="featured__title">{{ e.Title }}</h3>
      {% if e.meta %}<p class="featured__meta">{{ e.meta }}</p>{% endif %}
    </div>
  </a>
  {% endfor %}
</div>
{% endif %}

{% for group in lumen.pastByYear %}
<section class="year">
  <div class="year__head">
    <h3 class="year__n">{{ group.year }}</h3>
    <span class="year__count">{{ group.events.length }} event{% if group.events.length != 1 %}s{% endif %}</span>
  </div>
  <div class="grid">
    {% for e in group.events %}
    <a class="card" href="{{ e.url }}">
      <div class="card__media{% if not e.ImageURL %} is-empty{% endif %}">
        {% if e.ImageURL %}<img src="{{ e.ImageURL | img }}" alt="{{ e.Title }} — poster"{% if e.dims %} width="{{ e.dims.width }}" height="{{ e.dims.height }}"{% endif %} loading="lazy" decoding="async" />{% endif %}
      </div>
      {% if e.Date %}<p class="card__date">{{ e.Date | eventDate }}</p>{% endif %}
      <h4 class="card__title">{{ e.Title }}</h4>
      {% if e.meta %}<p class="card__meta">{{ e.meta }}</p>{% endif %}
    </a>
    {% endfor %}
  </div>
</section>
{% endfor %}
