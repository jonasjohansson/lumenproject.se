{# Reusable artists index — names only. Used by home (#artists) and /artists/. #}
<ul class="artists">
  {% for a in lumen.artists %}
  <li class="artist">
    {% if a.URL %}<a href="{{ a.URL }}" target="_blank" rel="noopener"><span class="artist__name">{{ a.Name | tc }}</span></a>{% else %}<span class="artist__name">{{ a.Name | tc }}</span>{% endif %}
  </li>
  {% endfor %}
</ul>
