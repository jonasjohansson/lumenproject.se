<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {# time-of-day theme: set before paint to avoid a flash. day · dusk · night.
     A saved choice (localStorage / ?theme=) wins over the clock. #}
  <script>
    (function () {
      try {
        var q = new URLSearchParams(location.search).get("theme");
        var f = q || localStorage.getItem("lumen-theme");
        var t;
        if (f === "day" || f === "dusk" || f === "night") t = f;
        else { var h = new Date().getHours();
          t = (h >= 6 && h < 17) ? "day" : (h >= 17 && h < 21) ? "dusk" : "night"; }
        document.documentElement.dataset.theme = t;
      } catch (e) { document.documentElement.dataset.theme = "night"; }
    })();
  </script>

  <title>{{ title or lumen.settings.site_title }}</title>
  <meta name="description" content="{{ description or lumen.settings.tagline }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  {% set ogImageAbs = (ogImage or lumen.settings.hero_image or "assets/img/photos/hero-dusk.jpg") | absImg %}
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:site_name" content="{{ lumen.settings.site_title }}" />
  <meta property="og:title" content="{{ title or lumen.settings.site_title }}" />
  <meta property="og:description" content="{{ description or lumen.settings.tagline }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  {% if ogImageAbs %}<meta property="og:image" content="{{ ogImageAbs }}" />{% endif %}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title or lumen.settings.site_title }}" />
  <meta name="twitter:description" content="{{ description or lumen.settings.tagline }}" />
  {% if ogImageAbs %}<meta name="twitter:image" content="{{ ogImageAbs }}" />{% endif %}

  <meta name="theme-color" content="#0a0b11" />
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/assets/img/favicon.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/style.css" />
</head>
<body>

  <a class="skip" href="#main">Skip to content</a>

  {% if current != 'home' %}<a class="corner-home" href="/">Lumen</a>{% endif %}

  {# minimal floating cluster: day/night toggle + active socials #}
  <div class="chrome">
    <button class="chrome__toggle" type="button" aria-label="Switch day / dusk / night" title="Day · Dusk · Night">
      <span class="g g-day" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></g></svg></span>
      <span class="g g-dusk" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 18h18M5 18a7 7 0 0 1 14 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 3v3M4 9l2 1M20 9l-2 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
      <span class="g g-night" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg></span>
    </button>
    <a class="chrome__ic" href="{{ lumen.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2c2.7 0 3 0 4.1.1 1 0 1.7.2 2.3.4.6.2 1.1.5 1.6 1 .5.5.8 1 1 1.6.2.6.4 1.3.4 2.3.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c0 1-.2 1.7-.4 2.3-.2.6-.5 1.1-1 1.6-.5.5-1 .8-1.6 1-.6.2-1.3.4-2.3.4-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-1 0-1.7-.2-2.3-.4-.6-.2-1.1-.5-1.6-1-.5-.5-.8-1-1-1.6-.2-.6-.4-1.3-.4-2.3C2 15 2 14.7 2 12s0-3 .1-4.1c0-1 .2-1.7.4-2.3.2-.6.5-1.1 1-1.6.5-.5 1-.8 1.6-1 .6-.2 1.3-.4 2.3-.4C9 2 9.3 2 12 2zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zM17.4 5.1a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6z"/></svg></a>
    <a class="chrome__ic" href="mailto:{{ lumen.settings.contact_email }}" aria-label="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm.6 2L12 12.6 20.4 7H3.6z"/></svg></a>
    <a class="chrome__ic" href="{{ lumen.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-8h2.6l.4-3h-3V8.1c0-.9.3-1.5 1.6-1.5H17V3.9c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1V10H8v3h2.6v8h2.9z"/></svg></a>
  </div>

  <main id="main">
    {{ content | safe }}
  </main>

  <script>
    (function () {
      var order = ["day", "dusk", "night"];
      var btn = document.querySelector(".chrome__toggle");
      if (!btn) return;
      btn.addEventListener("click", function () {
        var cur = document.documentElement.dataset.theme || "night";
        var next = order[(order.indexOf(cur) + 1) % order.length];
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("lumen-theme", next); } catch (e) {}
      });
    })();
  </script>

</body>
</html>
