<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {# Time-of-day theme — the single source of truth for theming.
     The resolver runs before paint (inline, here) to avoid a flash of the wrong
     theme; the toggle handler is wired on DOMContentLoaded. A saved choice
     (localStorage / ?theme=) wins over the clock. Themes: day · night. #}
  <script>
    (function () {
      var KEY = "lumen-theme", root = document.documentElement;
      function resolve() {
        try {
          var f = new URLSearchParams(location.search).get("theme") || localStorage.getItem(KEY);
          if (f === "day" || f === "night") return f;
        } catch (e) {}
        var h = new Date().getHours();
        return (h >= 6 && h < 18) ? "day" : "night";
      }
      root.dataset.theme = resolve();
      addEventListener("DOMContentLoaded", function () {
        var btn = document.querySelector(".chrome__toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          root.dataset.theme = root.dataset.theme === "day" ? "night" : "day";
          try { localStorage.setItem(KEY, root.dataset.theme); } catch (e) {}
        });
      });
    })();
  </script>

  <title>{{ title or lumen.settings.site_title }}</title>
  <meta name="description" content="{{ description or lumen.settings.tagline }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  {% set ogSrc = ogImage or site.ogImage.src %}
  {% set ogW = ogImageW or (site.ogImage.width if not ogImage) %}
  {% set ogH = ogImageH or (site.ogImage.height if not ogImage) %}
  {% set ogAlt = ogImageAlt or (site.ogImage.alt if not ogImage) or (title or lumen.settings.site_title) %}
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:site_name" content="{{ lumen.settings.site_title }}" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content="{{ title or lumen.settings.site_title }}" />
  <meta property="og:description" content="{{ description or lumen.settings.tagline }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ ogSrc | absImg }}" />
  <meta property="og:image:alt" content="{{ ogAlt }}" />
  {% if ogW %}<meta property="og:image:width" content="{{ ogW }}" />{% endif %}
  {% if ogH %}<meta property="og:image:height" content="{{ ogH }}" />{% endif %}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title or lumen.settings.site_title }}" />
  <meta name="twitter:description" content="{{ description or lumen.settings.tagline }}" />
  <meta name="twitter:image" content="{{ ogSrc | absImg }}" />
  <meta name="twitter:image:alt" content="{{ ogAlt }}" />

  <meta name="theme-color" content="#0a0b11" />
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/assets/img/favicon.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />

  <link rel="preload" href="/assets/fonts/barlow-condensed-700-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/css/fonts.css" />
  <link rel="stylesheet" href="/assets/css/style.css" />
</head>
<body>

  <a class="skip" href="#main">Skip to content</a>

  {# scrim behind the fixed header on flat pages (heroes provide their own) #}
  {% if current != 'home' and not hasHero %}<div class="topfade" aria-hidden="true"></div>{% endif %}

  {# header: the wordmark/home link pins to the far-left image edge; the section
     links align to the content gutter. On the home page the hero already carries
     the big wordmark, so the small logo is omitted there. #}
  {% if current != 'home' %}<a class="site-nav__home{% if hasHero %} site-nav__home--hero{% endif %}" href="/">Lumen Project</a>{% endif %}
  <nav class="site-nav{% if current == 'home' or hasHero %} site-nav--hero{% endif %}{% if current != 'home' %} site-nav--withlogo{% endif %}" aria-label="Sections">
    <a href="/events/"{% if current == 'events' %} aria-current="page"{% endif %}>Events</a>
    <a href="/gallery/"{% if current == 'gallery' %} aria-current="page"{% endif %}>Gallery</a>
    <a href="/about/"{% if current == 'about' %} aria-current="page"{% endif %}>About</a>
  </nav>

  {# minimal floating cluster: day/night toggle + active socials #}
  <div class="chrome">
    <button class="chrome__toggle" type="button" aria-label="Switch day / night" title="Day · Night">
      <span class="g g-day" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></g></svg></span>
      <span class="g g-night" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg></span>
    </button>
    <a class="chrome__ic" href="{{ lumen.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2c2.7 0 3 0 4.1.1 1 0 1.7.2 2.3.4.6.2 1.1.5 1.6 1 .5.5.8 1 1 1.6.2.6.4 1.3.4 2.3.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c0 1-.2 1.7-.4 2.3-.2.6-.5 1.1-1 1.6-.5.5-1 .8-1.6 1-.6.2-1.3.4-2.3.4-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-1 0-1.7-.2-2.3-.4-.6-.2-1.1-.5-1.6-1-.5-.5-.8-1-1-1.6-.2-.6-.4-1.3-.4-2.3C2 15 2 14.7 2 12s0-3 .1-4.1c0-1 .2-1.7.4-2.3.2-.6.5-1.1 1-1.6.5-.5 1-.8 1.6-1 .6-.2 1.3-.4 2.3-.4C9 2 9.3 2 12 2zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zM17.4 5.1a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6z"/></svg></a>
    <a class="chrome__ic" href="{{ lumen.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-7h2.3l.4-2.8h-2.7V9.4c0-.8.2-1.4 1.4-1.4h1.5V5.5c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2H8.2V14h2.3v7h3z"/></svg></a>
    <a class="chrome__ic" href="mailto:{{ lumen.settings.contact_email }}" aria-label="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm.6 2L12 12.6 20.4 7H3.6z"/></svg></a>
  </div>

  <main id="main">
    {{ content | safe }}
  </main>

  {% if current == 'home' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["Organization", "NGO"],
        "@id": "{{ site.url }}/#org",
        "name": "Lumen Project",
        "url": "{{ site.url }}/",
        "logo": "{{ site.url }}/assets/img/apple-touch-icon.png",
        "email": {{ lumen.settings.contact_email | dump | safe }},
        "description": {{ lumen.settings.tagline | dump | safe }},
        "sameAs": [
          {{ lumen.settings.instagram | dump | safe }},
          {{ lumen.settings.facebook | dump | safe }},
          {{ lumen.settings.youtube | dump | safe }}
        ]
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}/",
        "name": "Lumen Project",
        "publisher": { "@id": "{{ site.url }}/#org" }
      }
    ]
  }
  </script>
  {% endif %}

</body>
</html>
