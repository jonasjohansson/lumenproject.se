<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or lumen.settings.site_title }}</title>
  <meta name="description" content="{{ description or lumen.settings.tagline }}" />
  <link rel="preconnect" href="https://images.squarespace-cdn.com" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/style.css" />
</head>
<body id="page-{{ current }}" class="is-loaded">

  <header class="site-header">
    <div class="wrap">
      <div class="socials">
        <a class="icon" href="mailto:{{ lumen.settings.contact_email }}" aria-label="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm.6 2L12 12.6 20.4 7H3.6z"/></svg></a>
        <a class="icon" href="{{ lumen.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-8h2.6l.4-3h-3V8.1c0-.9.3-1.5 1.6-1.5H17V3.9c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1V10H8v3h2.6v8h2.9z"/></svg></a>
        <a class="icon" href="{{ lumen.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2c2.7 0 3 0 4.1.1 1 0 1.7.2 2.3.4.6.2 1.1.5 1.6 1 .5.5.8 1 1 1.6.2.6.4 1.3.4 2.3.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c0 1-.2 1.7-.4 2.3-.2.6-.5 1.1-1 1.6-.5.5-1 .8-1.6 1-.6.2-1.3.4-2.3.4-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-1 0-1.7-.2-2.3-.4-.6-.2-1.1-.5-1.6-1-.5-.5-.8-1-1-1.6-.2-.6-.4-1.3-.4-2.3C2 15 2 14.7 2 12s0-3 .1-4.1c0-1 .2-1.7.4-2.3.2-.6.5-1.1 1-1.6.5-.5 1-.8 1.6-1 .6-.2 1.3-.4 2.3-.4C9 2 9.3 2 12 2zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zM17.4 5.1a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6z"/></svg></a>
        <a class="icon" href="{{ lumen.settings.youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 7.5c-.1-.9-.5-1.6-1.4-1.8C19.9 5.3 12 5.3 12 5.3s-7.9 0-9.6.4C1.5 5.9 1.1 6.6 1 7.5.6 9.2.6 12 .6 12s0 2.8.4 4.5c.1.9.5 1.6 1.4 1.8 1.7.4 9.6.4 9.6.4s7.9 0 9.6-.4c.9-.2 1.3-.9 1.4-1.8.4-1.7.4-4.5.4-4.5s0-2.8-.4-4.5zM9.8 15.3V8.7l6.2 3.3-6.2 3.3z"/></svg></a>
      </div>
      <nav class="nav">
        <a href="/"{% if current == 'home' %} aria-current="page"{% endif %}>Home</a>
        <a href="/events/"{% if current == 'events' %} aria-current="page"{% endif %}>Events</a>
        <a href="/about/"{% if current == 'about' %} aria-current="page"{% endif %}>About</a>
        <a href="{{ lumen.settings.tickets_url }}" target="_blank" rel="noopener">Tickets</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <span>{{ lumen.settings.site_title }}</span>
      <a href="mailto:{{ lumen.settings.contact_email }}">{{ lumen.settings.contact_email }}</a>
      <span>{{ lumen.settings.photo_credit }}</span>
    </div>
  </footer>

</body>
</html>
