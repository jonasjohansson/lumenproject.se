---
pagination:
  data: lumen.redirects
  size: 1
  alias: r
permalink: "{{ r.from }}index.html"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Redirecting…</title>
  <link rel="canonical" href="{{ site.url }}{{ r.to }}" />
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content="0; url={{ r.to }}" />
  <script>location.replace("{{ r.to }}");</script>
</head>
<body><p>This page has moved to <a href="{{ r.to }}">{{ r.to }}</a>.</p></body>
</html>
